#!/usr/bin/env bash
# Lance le Chrome du terminal (chrome.mjs) avec le Node disponible : celui du PATH,
# sinon le plus recent installe par nvm (kitty lance depuis le menu ne charge pas nvm).
set -euo pipefail
NODE=$(command -v node || true)
if [ -z "$NODE" ]; then
    NODE=$(ls -1d "$HOME"/.nvm/versions/node/*/bin/node 2>/dev/null | sort -V | tail -1)
fi
if [ ! -x "${NODE:-}" ]; then
    echo "Node.js introuvable : installer Node pour utiliser le Chrome du terminal." >&2
    exit 1
fi
exec "$NODE" "$(dirname "$(readlink -f "$0")")/chrome.mjs" "$@"
